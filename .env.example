# PowerOffice Go API credentials
# Copy to .env and fill in values. Never commit .env.
#
# Keys are environment-specific. Demo keys only work on Demo URLs, and
# production keys only on production URLs.

# Application key (appKey) — username for OAuth token Basic Auth
POGO_APPLICATION_KEY=

# Client key (clientKey) — password for OAuth token Basic Auth
# Mapped to linked-service setting `client_id` in this provider.
POGO_CLIENT_ID=

# Subscription key (Ocp-Apim-Subscription-Key)
POGO_SUBSCRIPTION_KEY=

# Optional: demo vs production (defaults = production)
# Production:
#   POGO_HOST=https://goapi.poweroffice.net/
#   POGO_TOKEN_ENDPOINT=https://goapi.poweroffice.net/OAuth/Token
# Demo:
#   POGO_HOST=https://goapi.poweroffice.net/Demo/
#   POGO_TOKEN_ENDPOINT=https://goapi.poweroffice.net/Demo/OAuth/Token
POGO_HOST=https://goapi.poweroffice.net/
POGO_TOKEN_ENDPOINT=https://goapi.poweroffice.net/OAuth/Token
